<?xml version="1.0" encoding="utf-8"?>
<fonts-modification version="1">
    <family customizationType="new-named-family" name="lato">
        <font weight="400" style="normal">Lato-Regular.ttf</font>
        <font weight="400" style="italic">Lato-Italic.ttf</font>
        <font weight="500" style="normal">Lato-Medium.ttf</font>
        <font weight="500" style="italic">Lato-MediumItalic.ttf</font>
        <font weight="700" style="normal">Lato-Bold.ttf</font>
        <font weight="700" style="italic">Lato-BoldItalic.ttf</font>
    </family>
    <alias name="lato-medium" to="lato" weight="500" />
    <alias name="lato-bold" to="lato" weight="700" />

    <family customizationType="new-named-family" name="rubik">
        <font weight="400" style="normal">Rubik-Regular.ttf</font>
        <font weight="400" style="italic">Rubik-Italic.ttf</font>
        <font weight="500" style="normal">Rubik-Medium.ttf</font>
        <font weight="500" style="italic">Rubik-MediumItalic.ttf</font>
        <font weight="700" style="normal">Rubik-Bold.ttf</font>
        <font weight="700" style="italic">Rubik-BoldItalic.ttf</font>
    </family>
    <alias name="rubik-medium" to="rubik" weight="500" />
    <alias name="rubik-bold" to="rubik" weight="700" />

    <!-- Inter -->
    <family customizationType="new-named-family" name="inter">
        <font weight="100" style="normal">InterVariable.ttf
            <axis tag="wght" stylevalue="100"/>
            <axis tag="opsz" stylevalue="14"/>
        </font>
        <font weight="100" style="italic">InterVariable-Italic.ttf
            <axis tag="wght" stylevalue="100"/>
            <axis tag="opsz" stylevalue="14"/>
        </font>
        <font weight="300" style="normal">InterVariable.ttf
            <axis tag="wght" stylevalue="300"/>
            <axis tag="opsz" stylevalue="14"/>
        </font>
        <font weight="300" style="italic">InterVariable-Italic.ttf
            <axis tag="wght" stylevalue="300"/>
            <axis tag="opsz" stylevalue="14"/>
        </font>
        <font weight="400" style="normal">InterVariable.ttf
            <axis tag="wght" stylevalue="400"/>
            <axis tag="opsz" stylevalue="14"/>
        </font>
        <font weight="400" style="italic">InterVariable-Italic.ttf
            <axis tag="wght" stylevalue="400"/>
            <axis tag="opsz" stylevalue="14"/>
        </font>
        <font weight="500" style="normal">InterVariable.ttf
            <axis tag="wght" stylevalue="500"/>
            <axis tag="opsz" stylevalue="14"/>
        </font>
        <font weight="500" style="italic">InterVariable-Italic.ttf
            <axis tag="wght" stylevalue="500"/>
            <axis tag="opsz" stylevalue="14"/>
        </font>
        <font weight="700" style="normal">InterVariable.ttf
            <axis tag="wght" stylevalue="700"/>
            <axis tag="opsz" stylevalue="14"/>
        </font>
        <font weight="700" style="italic">InterVariable-Italic.ttf
            <axis tag="wght" stylevalue="700"/>
            <axis tag="opsz" stylevalue="14"/>
        </font>
        <font weight="900" style="normal">InterVariable.ttf
            <axis tag="wght" stylevalue="900"/>
            <axis tag="opsz" stylevalue="14"/>
        </font>
        <font weight="900" style="italic">InterVariable-Italic.ttf
            <axis tag="wght" stylevalue="900"/>
            <axis tag="opsz" stylevalue="14"/>
        </font>
    </family>
    <alias name="inter-thin" to="inter" weight="100" />
    <alias name="inter-light" to="inter" weight="300" />
    <alias name="inter-regular" to="inter" weight="400" />
    <alias name="inter-medium" to="inter" weight="500" />
    <alias name="inter-bold" to="inter" weight="700" />
    <alias name="inter-black" to="inter" weight="900" />
</fonts-modification>
